# data/processed/*
# !data/raw/.gitkeep
# !data/processed/.gitkeep
# data/letterboxd/_new_crawl/
# data/letterboxd/data/
# data/letterboxd/raw.rar

# Artifacts - keep .gitkeep placeholder
artifacts/*
!artifacts/.gitkeep

# Large binary formats
*.pt
*.pth
*.npy
*.npz

# Kaggle outputs
kaggle_outputs/
movierec3_kaggle_input.zip

# Logs
logs/
log/
log_tensorboard/
